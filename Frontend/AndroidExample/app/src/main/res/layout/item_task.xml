<?xml version="1.0" encoding="utf-8"?>

<!--  layout for each task card showing title, description. status, due date, and edit/delete buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/task_item_bg"
    android:elevation="4dp">

    <!-- task title shown at the tp of the card-->
    <TextView
        android:id="@+id/tvTitle"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- short description of the task -->
    <TextView
        android:id="@+id/tvDescription"
        android:textSize="15sp"
        android:textColor="#FFF5EE"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!--current status of the task-->
    <TextView
        android:id="@+id/tvStatus"
        android:textSize="13sp"
        android:textColor="#FFEB3B"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- task due date -->
    <TextView
        android:id="@+id/tvDueDate"
        android:textSize="13sp"
        android:textColor="#FFE0B2"
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!--horizonta section for edit nd delete buttons-->

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <!-- button to edit task details-->
        <Button
            android:id="@+id/btnEdit"
            android:text="Edit"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <!-- button to delete the task-->
        <Button
            android:id="@+id/btnDelete"
            android:text="Delete"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
