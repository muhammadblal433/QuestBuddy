<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#f97316"
            android:gravity="center">

            <TextView
                android:id="@+id/dayDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 9, 2025"
                android:textColor="@android:color/white"
                android:textSize="24sp" />
        </LinearLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Left column for times -->
                <LinearLayout
                    android:id="@+id/timeColumn"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start" />

                <!-- Right column for task blocks -->
                <FrameLayout
                    android:id="@+id/taskColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FAFAFA" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Floating button -->
    <Button
        android:id="@+id/addTaskBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:textColor="@android:color/white"
        android:backgroundTint="#f97316"
        android:background="@drawable/rounded_button_border"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <Button
        android:id="@+id/returnCalendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Return"
        android:textColor="@android:color/white"
        android:backgroundTint="#f97316"
        android:background="@drawable/rounded_button_border"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>