<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="#E65100"
    android:elevation="4dp">

    <!-- shows the display name of the friend -->
    <TextView
        android:id="@+id/tvFriendName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friend Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- shows the friend's username -->
    <TextView
        android:id="@+id/tvFriendUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="15sp"
        android:textColor="#FFF5EE"
        android:layout_marginTop="4dp" />

    <!-- button to unfriend someone -->
    <Button
        android:id="@+id/btnUnfriend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UNFRIEND"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- button to accept a friend request -->
    <Button
        android:id="@+id/btnAccept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACCEPT"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- button to reject a friend request -->
    <Button
        android:id="@+id/btnReject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REJECT"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F44336"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
