<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E1"
    tools:context=".NotificationsActivity">

    <!-- top orange header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF9800"
        android:text="Notifications"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp" />

    <!-- buttons for actions like loading, filtering, and clearing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnLoadNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:text="Load" />

        <Button
            android:id="@+id/btnUnreadFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF"
            android:text="Unread" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:text="Clear All" />
    </LinearLayout>

    <!-- message shown when there are no notifications -->
    <TextView
        android:id="@+id/tvNoNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No notifications to show"
        android:textAlignment="center"
        android:textColor="#9E9E9E"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- list area for showing notifications -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:clipToPadding="false"
        android:paddingBottom="70dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_notification" />

    <!-- floating button to add a new notification -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#FF9800"
        app:tint="#FFFFFF" />

    <!-- button to go back to the home screen -->
    <Button
        android:id="@+id/btnReturnHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Return to Home"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:paddingLeft="20dp"
        android:paddingRight="20dp" />

</LinearLayout>
